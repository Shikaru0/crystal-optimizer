{
	"schemaVersion": 1,
	"id": "crystal-optimizer",
	"version": "${version}",
	"name": "crystal-optimizer",
	"description": "Optimizes client-sided packets related to Crystal PvP",
	"authors": [
		"Shikaru0"
	],
	"contact": {
		"homepage": "https://github.com/Shikaru0",
		"sources": "https://github.com/Shikaru0/crystal-optimizer"
	},
	"license": "MIT",
	"icon": "assets/crystal-optimizer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"name.modid.CrystalOptimizer"
		],
		"client": [
			"name.modid.client.CrystalOptimizerClient"
		]
	},
	"mixins": [
		"crystal-optimizer.mixins.json",
		{
			"config": "crystal-optimizer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}